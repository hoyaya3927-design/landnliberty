  <script>
    function updateClockAndDday() {
      const now = new Date();
      document.getElementById('live-clock').textContent = now.toLocaleString('ko-KR', {
        year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
      });
      const electionDate = new Date('2028-04-12T06:00:00+09:00');
      const diffDays = Math.ceil((electionDate - now) / (1000 * 60 * 60 * 24));
      document.getElementById('dday-counter').textContent = diffDays > 0 ? `D-${diffDays}일` : '선거일 도래';
    }
    updateClockAndDday();
    setInterval(updateClockAndDday, 60000);

    function calcSavings() {
      const perMp = parseFloat(document.getElementById('cost-per-mp').value) || 0;
      const count = parseInt(document.getElementById('mp-count').value, 10);
      const totalSaved = (perMp * 0.5 * 4 * count).toLocaleString('ko-KR');
      document.getElementById('savings-result').textContent = `${totalSaved}억 원 절감`;
    }

    function filterCandidates(type, btn) {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.cand-item').forEach(card => {
        if (type === 'all' || card.dataset.card === type) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function searchCandidates(query) {
      const q = query.trim().toLowerCase();
      document.querySelectorAll('.cand-item').forEach(card => {
        const text = (card.innerText + ' ' + (card.dataset.search || '')).toLowerCase();
        card.style.display = text.includes(q) ? 'block' : 'none';
      });
    }

    function buildInquiry() {
      const target = document.getElementById('q-target').value.trim() || '○○ 선거구 국회의원(예비후보) 귀하';
      const sender = document.getElementById('q-sender').value.trim() || '지역구 유권자 일동';
      document.getElementById('inquiry-output').textContent =
`[제23대 총선 6개월 전 유권자 공개 정책 질의서]
수신: ${target}
발신: ${sender} (2028 국회 리셋 시민 검증단 · 디지털 대동법 연구소 연계)

「개헌이 먼저가 아니다. 2028 국회 리셋!」 5대 원칙 및 10대 개혁 과제에 따라 다음 핵심 사안에 대한 [찬성 / 반대 / 유보] 공식 입장을 14일 이내에 회신해 주시기 바랍니다.

1. 선관위법 개정을 통한 중앙·시도·시군구 선관위 우선 해체 및 재구성
2. 공직선거법 개정을 통한 2028 총선 전 사전투표 전면 폐지 및 각 투표소 당일개표·수개표 시행
3. 제23대 총선 6개월 전 현직 국회의원 전원 국민 검증 응답 및 의원 총비용 50% 감축
4. 제23대 국회 구성 후 개헌특위를 통한 국민 숙의형 개헌 논의
5. 제23대 국회 구성 후 현직 대통령 잔여 임기 국민 전체 재신임 투표 원칙

※ 회신 결과 및 기한 내 미제출(검증 불가) 여부는 LandnLiberty.kr 지역구 검증소에 원문 그대로 공개됩니다.`;
    }
