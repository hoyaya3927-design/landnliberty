    .roadmap-banner {
      background: #FFFFFF;
      border: 2px solid var(--primary);
      border-radius: 14px;
      padding: 30px;
      box-shadow: 0 6px 20px rgba(15, 61, 62, 0.08);
    }
    .roadmap-title { font-size: 1.35rem; font-weight: 800; color: var(--crimson); margin-bottom: 6px; }
    .roadmap-sub { font-size: 0.94rem; color: var(--muted); margin-bottom: 20px; }
    .step-list { list-style: none; display: grid; gap: 12px; }
    .step-list li {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      background: #F8FAFC;
      border: 1px solid var(--border);
      border-left: 4px solid var(--primary);
      padding: 14px 16px;
      border-radius: 8px;
      font-size: 0.96rem;
    }
    .step-num {
      background: var(--primary);
      color: #FFF;
      font-weight: 800;
      font-size: 0.82rem;
      min-width: 28px;
      height: 28px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 2px;
    }

    /* Grid & Cards */
    .grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(440px, 1fr));
      gap: 20px;
    }
    @media (max-width: 520px) { .grid-2 { grid-template-columns: 1fr; } }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 22px;
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
    }
    .card h3 { font-size: 1.12rem; font-weight: 700; margin: 10px 0 8px; color: var(--darker); }
    .badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 800;
      padding: 3px 9px;
      border-radius: 4px;
    }
    .b-confirmed { background: var(--badge-confirmed-bg); color: var(--badge-confirmed); }
    .b-progress { background: var(--badge-progress-bg); color: var(--badge-progress); }
    .b-caution { background: var(--badge-caution-bg); color: var(--badge-caution); }

    /* Notice Box */
    .method-box {
      background: #F1F5F9;
      border-left: 4px solid #334155;
      padding: 16px 20px;
      border-radius: 8px;
      font-size: 0.9rem;
      color: #1E293B;
      margin-top: 16px;
    }

    /* Manifesto Box */
    .manifesto-box {
      background: #FFFFFF;
      border: 1px solid #CBD5E1;
      border-top: 5px solid var(--primary);
      border-radius: 12px;
      padding: 32px;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }
    .manifesto-quote {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--primary);
      background: #F0FDF4;
      padding: 14px 18px;
      border-left: 4px solid var(--primary);
      border-radius: 6px;
      margin-bottom: 20px;
    }
    .manifesto-box p { margin-bottom: 14px; font-size: 0.98rem; }
    .manifesto-list { list-style: none; margin: 18px 0; display: grid; gap: 10px; }
    .manifesto-list li {
      background: #F8FAFC;
      padding: 12px 16px;
      border-radius: 8px;
      border-left: 3px solid var(--gold);
      font-size: 0.94rem;
    }

    /* Comparison Table */
    .table-wrap { overflow-x: auto; }
    table {
      width: 100%;
      border-collapse: collapse;
      background: #FFF;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border);
      font-size: 0.91rem;
    }
    th {
      background: var(--primary);
      color: #FFF;
      text-align: left;
      padding: 12px 14px;
      font-weight: 700;
    }
    td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    tr:nth-child(even) td { background: #F8FAFC; }

    /* Toolkit */
    .toolkit-panel {
      background: #FFF;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
    }
    select, input[type="text"], textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #CBD5E1;
      border-radius: 8px;
      font-size: 0.92rem;
      margin-top: 6px;
      margin-bottom: 12px;
      font-family: inherit;
    }
    .output-box {
      background: #0F172A;
      color: #E2E8F0;
      padding: 16px;
      border-radius: 8px;
      font-size: 0.86rem;
      white-space: pre-wrap;
      font-family: "Consolas", monospace;
      margin-top: 10px;
    }

    footer {
      background: var(--darker);
      color: #94A3B8;
      padding: 36px 24px;
      font-size: 0.86rem;
      text-align: center;
      border-top: 3px solid var(--primary);
    }
    footer strong { color: #FFF; }
