      margin-bottom: 24px;
      border-left: 4px solid var(--primary);
      padding-left: 14px;
    }
    .sec-header h2 { font-size: 1.5rem; font-weight: 800; color: var(--darker); }
    .sec-header p { font-size: 0.95rem; color: var(--muted); margin-top: 4px; }

